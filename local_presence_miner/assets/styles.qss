QMainWindow, QWidget {
  background: #f5f7fb;
  color: #172033;
  font-size: 10pt;
}
QListWidget {
  background: #172033;
  color: #eef4fb;
  border: 0;
  padding: 8px;
}
QListWidget::item {
  padding: 10px;
  border-radius: 5px;
}
QListWidget::item:selected {
  background: #2f6fed;
}
QPushButton {
  background: #2f6fed;
  color: white;
  border: 0;
  border-radius: 5px;
  padding: 8px 12px;
}
QPushButton:disabled {
  background: #9aa8bd;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QTableWidget {
  background: white;
  border: 1px solid #cfd8e6;
  border-radius: 4px;
  padding: 4px;
}
